# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: canonical public URL used for the shareable join/leaderboard links.
# Set this in production (e.g. your Netlify URL) so share links are always public
# even if a match is created from localhost. If unset, the current origin is used.
# NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
